# ==============================================================================
# Realtime Communication System — Environment Configuration Template
# Copy this file to `.env` for local overrides. NEVER commit `.env` to git.
# ==============================================================================

# HTTP & Socket.IO server listening port (read by server.js via process.env.PORT)
PORT=4000

# Runtime environment: development | staging | production
NODE_ENV=development

# Recommended production extensions (not yet wired in boilerplate server.js):
# ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
# JWT_SECRET=replace-with-256-bit-random-secret
# REDIS_URL=redis://localhost:6379
